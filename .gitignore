# Publish only source code, required assets, and installation / usage instructions.
# New top-level files are private until explicitly added to this allowlist.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/vite.config.ts
!/playwright.config.ts
!/electron-builder.yml
!/src/
!/electron/
!/scripts/
!/tests/
!/public/
!/build/
!/docs/
!/.github/

# Public documentation and build resources have their own allowlists.
/docs/*
!/docs/Windows客户端.md
/build/*
!/build/icon.png
!/build/icon.ico
/public/*
!/public/favicon.svg
!/public/demo.epub
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
/tests/fixtures/README.md

# Keep credentials, local settings, personal books, and generated files private.
node_modules/
dist/
release/
test-results/
playwright-report/
coverage/
.env
.env.*
.npmrc
*.pem
*.key
*.p12
*.pfx
*.log
*.tsbuildinfo
.DS_Store
Thumbs.db
*.epub
!/public/demo.epub
!/tests/fixtures/epub2.epub
!/tests/fixtures/epub3.epub
!/tests/fixtures/no-toc.epub
!/tests/fixtures/same-title.epub
!/tests/fixtures/unsafe.epub
!/tests/fixtures/corrupt.epub
!/tests/fixtures/missing-opf.epub
