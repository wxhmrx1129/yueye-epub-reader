{
  "name": "yueye-epub-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:pack": "npm run build && electron-builder --win --x64 --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis --x64",
    "test:desktop": "npm run build && node --test tests/desktop-policy.test.cjs && node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "dompurify": "^3.3.0",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "description": "阅野 · 本地 EPUB 阅读器 Windows 客户端",
  "author": "Yueye Reader",
  "main": "electron/main.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wxhmrx1129/yueye-epub-reader.git"
  },
  "bugs": {
    "url": "https://github.com/wxhmrx1129/yueye-epub-reader/issues"
  },
  "homepage": "https://github.com/wxhmrx1129/yueye-epub-reader#readme"
}
